<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/testPanelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/test_panel_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/testPanelSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_panel_subtitle"
        android:textAlignment="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/testPanelTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/armSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arm_switch_label"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/testPanelSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/debugCheckGateStatusButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/debug_check_gate_status"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/debugRunScheduledCheckButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/debugRunArmGateSequenceButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/debug_run_arm_gate_sequence"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/debugCheckGateStatusButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/triggerImmediateButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_immediate"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/armSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/trigger1MinButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_1min"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/triggerImmediateButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/trigger5MinButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_5min"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/trigger1MinButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/trigger11MinButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_11min"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/trigger5MinButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/triggerDedupWideGapButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_dedup_wide"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/trigger11MinButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/triggerDedupTightRaceButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_dedup_tight"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/triggerDedupWideGapButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/triggerDedupTightRaceReversedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_trigger_dedup_tight_reversed"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/triggerDedupTightRaceButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/debugArmButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/debug_arm_button"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/triggerDedupTightRaceReversedButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/debugDisarmButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/debug_disarm_button"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/debugArmButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/debugRunScheduledCheckButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/debug_run_scheduled_check"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/trigger1MinButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>