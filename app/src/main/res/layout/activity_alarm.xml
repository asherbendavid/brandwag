<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/alarm_background">

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_screen_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/alarm_text"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/alarmGustText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/alarm_text"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        tools:text="Max forecast gust: 62 km/h"
        xmlns:tools="http://schemas.android.com/tools" />

    <Button
        android:id="@+id/snoozeButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/alarm_snooze_button"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/dismissButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/alarm_dismiss_button"
        android:textSize="18sp" />

</LinearLayout>